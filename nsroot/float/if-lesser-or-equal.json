{
  "prefix": [
    "if float <=",
    "if double <="
  ],
  "body": [
    "if (",
    "\t_shellman_float_left=\"\\${${1:num1}}\"",
    "\t_shellman_float_right=\"\\${${2:num2}}\"",
    "\t_shellman_float_valid=1",
    "\tfor _shellman_float_operand in \"$_shellman_float_left\" \"$_shellman_float_right\"; do",
    "\t\tcase $_shellman_float_operand in +*|-*) _shellman_float_operand=${_shellman_float_operand#?} ;; esac",
    "\t\tcase $_shellman_float_operand in ''|*[!0123456789.]*|*.*.*) _shellman_float_valid=0 ;; esac",
    "\t\tcase $_shellman_float_operand in *[0123456789]*) : ;; *) _shellman_float_valid=0 ;; esac",
    "\tdone",
    "\tif [ \"$_shellman_float_valid\" -eq 0 ]; then",
    "\t\tprintf '%s\\n' 'float lesser-or-equal: invalid decimal operand' >&2",
    "\t\texit 2",
    "\tfi",
    "\tcase $_shellman_float_left in +*) _shellman_float_left=${_shellman_float_left#?} ;; esac",
    "\tcase $_shellman_float_right in +*) _shellman_float_right=${_shellman_float_right#?} ;; esac",
    "\tif _shellman_float_result=$(LC_ALL=C bc -l <<_SHELLMAN_FLOAT_BC_",
    "$_shellman_float_left <= $_shellman_float_right",
    "_SHELLMAN_FLOAT_BC_",
    "\t); then",
    "\t\tcase $_shellman_float_result in",
    "\t\t\t1) exit 0 ;;",
    "\t\t\t0) exit 1 ;;",
    "\t\t\t*) printf '%s\\n' 'float lesser-or-equal: unexpected bc output' >&2; exit 3 ;;",
    "\t\tesac",
    "\telse",
    "\t\tprintf '%s\\n' 'float lesser-or-equal: bc failed' >&2",
    "\t\texit 3",
    "\tfi",
    "); then",
    "\t${3:echo \"lesser or equal\"}",
    "else",
    "\tcase $? in",
    "\t\t1) : ;;",
    "\t\t2) (exit 2) ;;",
    "\t\t*) (exit 3) ;;",
    "\tesac",
    "fi\n"
  ],
  "description": "if num1 is lesser or equal to num2"
}
