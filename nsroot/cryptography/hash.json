{
  "prefix": "crypto hash",
  "body": "${1:hash}=\\$(\n  hash_output=$(printf '%s' \"\\$${2:variableToHash}\" | ${3|md5sum,shasum,sha1sum,sha224sum,sha256sum,sha384sum,sha512sum|}) || exit\n  printf '%s\\n' \"\\${hash_output%% *}\"\n)\n",
  "description": "compute hash of variable (md5, sha, sha1, sha224, sha256, sha384, sha512)"
}
