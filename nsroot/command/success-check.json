{
  "prefix": [
    "command success check",
    "cmd success check"
  ],
  "body": [
    "if {",
    "\t${1:command}",
    "} >/dev/null 2>&1; then",
    "\techo \"succeed\"",
    "else",
    "\t(",
    "\t\tset -- \"\\$?\"",
    "\t\techo \"failed\" || exit",
    "\t\texit \"\\$1\"",
    "\t)",
    "fi\n"
  ],
  "description": "check if last command succeed"
}
